{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcanfest-qa",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-08",
  "build": { "command": "node worker/generate-sizes.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Safari necesita 206 para video y los Static Assets no soportan Range.
    "run_worker_first": ["/img/spot.mp4", "/img/spot-reel.mp4"]
  }
}
